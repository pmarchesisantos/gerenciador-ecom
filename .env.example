# ---------------------------------------------------------------------------
# Local: copie este arquivo para ".env" e preencha. O .env nao vai para o git.
# Vercel: cadastre as mesmas chaves em Settings > Environment Variables.
# ---------------------------------------------------------------------------

# 1) Supabase -----------------------------------------------------------------
#    Project Settings > Data API > Project URL
SUPABASE_URL=
#    Project Settings > API Keys > service_role (SECRETA, so no servidor)
SUPABASE_SERVICE_KEY=
#    Project Settings > API Keys > anon / publishable
#    Usada para validar e-mail e senha no login.
SUPABASE_ANON_KEY=

# 2) Endereco publico do app ---------------------------------------------------
#    Entra no redirect URI das plataformas. Em producao precisa ser https.
BASE_URL=http://127.0.0.1:8000

# 3) Chave de criptografia dos segredos guardados no Supabase ------------------
#    OBRIGATORIA em producao. Gere uma vez com:
#      python -m app.cripto
#    Local, se ficar vazia, o app gera e guarda em data/chave.key.
#    Trocar esta chave torna ilegiveis todos os segredos ja gravados.
CHAVE_CRIPTO=

# 4) Chave que assina o cookie de login ----------------------------------------
#    OBRIGATORIA em producao. Qualquer texto longo e aleatorio serve:
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#    Trocar esta chave apenas desconecta todo mundo.
CHAVE_SESSAO=

# 5) Ambiente ------------------------------------------------------------------
#    Detectado sozinho na Vercel. Use "producao" para testar as travas localmente.
AMBIENTE=local

# 6) Fuso usado para agrupar os pedidos por dia --------------------------------
FUSO=America/Sao_Paulo
